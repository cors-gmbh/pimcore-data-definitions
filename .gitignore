/vendor/
/node_modules/
/.rsbuild/
/dist/
.DS_Store
.idea/
.php-cs-fixer.cache
# dev environment only, the bundle itself must not pin its PHP dependencies
/composer.lock

# --- dev harness ---
# var is generated, but PHPStan (Pimcore extension) needs var/classes/DataObject in CI
/var/*
!/var/classes
/var/classes/*
!/var/classes/DataObject
/var/classes/DataObject/*
!/var/classes/DataObject/.gitkeep
# the anchored var rule above does not cover the web root
/public/var
/public/bundles
.env.local
.env.*.local
# config.yaml imports local/*.yaml; the kernel fails without the directory in CI
/config/local/*
!/config/local/.gitkeep
/config/reference.php
/config/pimcore/data-definitions
/compose.override.yaml
/docker-compose.override.yaml
/.docker
supervisord.pid

# --- Behat ---
/etc/build/*
!/etc/build/.gitkeep
/test.csv

# --- Studio frontend build ---
# Expanded Studio build. Not committed: the build ships as an archive in
# src/Resources/build-dist/build-<id>.zip, which Pimcore's BuildArchiveExtractor
# unpacks into src/Resources/public/studio at cache warmup. The extractor's
# marker, lock and temporary directories live next to the build.
/src/Resources/public/studio/*
/src/Resources/public/.studio*
